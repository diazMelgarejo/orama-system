#!/usr/bin/env bash
# post-commit: auto-sync oramaclaw vendor mirror into Perpetua-Tools when
# src/oramaclaw/ changes. Fires only on commits that touch those files.
# Requires PERPETUA_TOOLS_ROOT or PERPETUA_TOOLS_PATH to be set; silently
# skips if neither is set (CI or machines without PT checked out).

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0

if ! git diff-tree --no-commit-id -r HEAD --name-only 2>/dev/null | grep -q '^src/oramaclaw/'; then
  exit 0
fi

if [[ -z "${PERPETUA_TOOLS_ROOT:-}${PERPETUA_TOOLS_PATH:-}" ]]; then
  exit 0
fi

bash "$REPO_ROOT/scripts/sync-oramaclaw-vendor.sh" 2>&1 | sed 's/^/[oramaclaw-sync] /' || true
