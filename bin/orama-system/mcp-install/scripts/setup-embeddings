#!/usr/bin/env bash
# setup-embeddings — idempotent wire-up of gbrain + code-review-graph shared embeddings
# Run this after any fresh checkout or after changing the Ollama model.
# Safe to re-run — checks state before acting.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=../../scripts/lib/openclaw-env.sh
source "$SCRIPT_DIR/../../scripts/lib/openclaw-env.sh"

ensure_openclaw_mcp_json echo || {
  echo "ERROR: could not resolve or create OpenClaw .mcp.json (set OPENCLAW_ROOT)" >&2
  exit 1
}
OPENCLAW_DIR="${OPENCLAW_DIR:-$(detect_openclaw_root)}"
MCP_JSON="$(resolve_openclaw_mcp_json)"

echo "=== setup-embeddings (idempotent) ==="
echo "OpenClaw dir: $OPENCLAW_DIR"

# --- 1. Verify prerequisites ---
fail=0
command -v gbrain &>/dev/null || { echo "ERROR: gbrain not on PATH. Run /setup-gbrain first."; fail=1; }
command -v uvx &>/dev/null || { echo "ERROR: uvx not on PATH. Install uv: curl -LsSf https://astral.sh/uv/install.sh | sh"; fail=1; }
command -v jq &>/dev/null || { echo "ERROR: jq not on PATH. Install: brew install jq"; fail=1; }
[ "$fail" -eq 0 ] || exit 1

# --- 2. Verify Ollama + bge-m3 ---
if curl -s http://localhost:11434/api/tags 2>/dev/null | grep -q "bge-m3"; then
  echo "[OK] Ollama bge-m3 available"
  OLLAMA_OK=1
else
  echo "[WARN] Ollama not reachable or bge-m3 not pulled"
  echo "       Run: ollama pull bge-m3"
  echo "       Continuing — CRG will use FTS-only until Ollama is running"
  OLLAMA_OK=0
fi

# --- 3. Wire CRG → Ollama bge-m3 (idempotent) ---
CURRENT_MODEL=$(jq -r '.mcpServers["code-review-graph"].env.CRG_OPENAI_MODEL // ""' "$MCP_JSON" 2>/dev/null || echo "")
if [ "$CURRENT_MODEL" = "bge-m3" ]; then
  echo "[OK] .mcp.json already wired to bge-m3 (no change)"
else
  SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  # crg-embed-mode now lives in the code-review skill subtree (2026-05-19 migration)
  CRG_EMBED_MODE="$SCRIPT_DIR/../../skills/code-review/scripts/crg-embed-mode"
  "$CRG_EMBED_MODE" gbrain
  echo "[SET] .mcp.json updated → bge-m3 mode"
fi

# --- 4. Verify gbrain sources are pinned ---
WORKTREES=(
  "$OPENCLAW_DIR/AlphaClaw"
  "$OPENCLAW_DIR/orama-system"
  "$OPENCLAW_DIR/perplexity-api/Perpetua-Tools"
)
for wt in "${WORKTREES[@]}"; do
  if [ -f "$wt/.gbrain-source" ]; then
    src=$(cat "$wt/.gbrain-source")
    echo "[OK] gbrain-source pinned: $(basename "$wt") → $src"
  else
    echo "[WARN] $wt missing .gbrain-source — run /sync-gbrain --full in that worktree"
  fi
done

# --- 5. Quick embed smoke test ---
if [ "$OLLAMA_OK" -eq 1 ]; then
  echo "[TEST] OpenAI-compat embed round-trip..."
  DIM=$(curl -s -X POST http://localhost:11434/v1/embeddings \
    -H "Content-Type: application/json" \
    -d '{"model":"bge-m3","input":"smoke test"}' 2>/dev/null \
    | python3 -c "import sys,json; d=json.load(sys.stdin); print(len(d['data'][0]['embedding']))" 2>/dev/null || echo "0")
  if [ "$DIM" = "1024" ]; then
    echo "[OK] bge-m3 returns 1024-dim vectors"
  else
    echo "[WARN] bge-m3 embed returned unexpected dim=$DIM"
  fi
fi

echo ""
echo "=== setup-embeddings complete ==="
echo "Next steps:"
echo "  1. Restart Claude Code to reload MCP server with new .mcp.json"
echo "  2. Call embed_graph_tool via MCP to re-embed CRG graph with bge-m3"
echo "  3. Run: gbrain sources list — to verify all worktrees indexed"
