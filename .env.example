# orama-system — environment template (NO SECRETS — safe to commit)
#
# Catch-up guide: docs/local-env-catch-up.md
# Check:          bash scripts/check-local-env.sh
#
# Setup:
#   cp .env.example .env.local
#   Edit LAN IPs + paths; put API keys/tokens only in .env.local (gitignored).
#   Optional: use .env for non-secret endpoints and .env.local for Tier S secrets.
#
# OPENCLAW_ROOT = parent directory of this repo (contains orama-system + siblings).
# Example: /Users/you/projects/OpenClaw

# =============================================================================
# Tier S — SECRETS (.env.local only — rotate if ever committed to git)
# =============================================================================
# Required after 2026-05-23 redaction (config/mac-orchestrator.json uses ${env:...})
OPENCLAW_TELEGRAM_BOT_TOKEN=
OPENCLAW_GATEWAY_AUTH_TOKEN=
OPENCLAW_MODELS_PROVIDERS_GEMINI_MAIN_APIKEY=
OPENCLAW_MODELS_PROVIDERS_GEMINI_FALLBACK_APIKEY=

# Portal / bootstrap
SETUP_PASSWORD=change-me-before-network-use
ORAMA_CONTROL_PLANE_TOKEN=change-me-before-network-use
# ORAMA_INSECURE_DEV=1  # local pytest/CI only — never in production

# Service bind (loopback default; set *_BIND_LAN=1 to expose on LAN)
# PT_HOST=localhost
# ULTRATHINK_HOST=localhost
# PORTAL_HOST=localhost
# PT_BIND_LAN=0
# ORAMA_BIND_LAN=0
# PORTAL_BIND_LAN=0

# Optional cloud / routing
XAI_API_KEY=
OPENROUTER_API_KEY=

# =============================================================================
# Tier L — layout (optional if auto-detect works)
# =============================================================================
# OPENCLAW_ROOT=/absolute/path/to/OpenClaw
# ORAMA_REPO_ROOT=/absolute/path/to/orama-system
# OPENCLAW_MCP_JSON=/absolute/path/to/OpenClaw/.mcp.json
# PERPETUA_TOOLS_ROOT=/absolute/path/to/perplexity-api/Perpetua-Tools
# ORAMA_STATE_DIR=~/.orama-system

# =============================================================================
# Tier H — API server (orama)
# =============================================================================
API_HOST=localhost
API_PORT=8001
ULTRATHINK_HOST=localhost
ULTRATHINK_PORT=8001
ULTRATHINK_MAX_TASK_LENGTH=10000
ULTRATHINK_MAX_TIMEOUT=300

# === OLLAMA MODELS ===
DEFAULT_MODEL=Qwen3.5-27B-Claude-4.6-Opus-Reasoning-Distilled-v2
FAST_MODEL=Qwen3.5-9B-MLX-4bit
CODE_MODEL=Qwen3.5-27B-Claude-4.6-Opus-Reasoning-Distilled-v2

# === OLLAMA ENDPOINTS (LAN setup) ===
OLLAMA_MAC_ENDPOINT=http://localhost:11434
OLLAMA_WINDOWS_ENDPOINT=http://192.168.1.100:11434
OLLAMA_TIMEOUT=120

# === LM STUDIO — PRIMARY LOCAL BACKEND ===
LM_STUDIO_MAC_ENDPOINT=http://localhost:1234
LMS_MAC_MODEL=Qwen3.5-9B-MLX-4bit
LMS_MAC_CONTEXT=8192

WIN_LM_STUDIO_HOST=
LM_STUDIO_WIN_ENDPOINTS=http://192.168.254.108:1234
LMS_WIN_MAX_PARALLEL=4
LMS_WIN_MODEL=Qwen3.5-27B-Claude-4.6-Opus-Reasoning-Distilled-v2

LM_STUDIO_API_TOKEN=lmstudio
LM_STUDIO_TIMEOUT=120

# === PORTAL ===
PORTAL_PORT=8002
PORTAL_HOST=localhost

# === CLOUD / CROSS-REPO ===
ORCHESTRATOR_ENDPOINT=http://localhost:8000
ULTRATHINK_ENDPOINT=http://localhost:8001

# === SECURITY ===
ALLOWED_HOSTS=*

# === ORAMA ROUTING (optional overrides) ===
# ORAMA_PLATFORM=mac
# ORAMA_BACKEND_PRIORITY=local

# === OPENCLAW GATEWAY (MCP bridge / bootstrap) ===
OPENCLAW_GATEWAY=http://localhost:18789
# OPENCLAW_GATEWAY_URL=
# OPENCLAW_GATEWAY_PORT=18789
# OPENCLAW_TIMEOUT=120

# === LOGGING ===
LOG_LEVEL=INFO

# === PYTHON PATH (adjust if your shell differs) ===
# PYTHONPATH=./bin/orama-system:./bin/shared:./bin

# === CODEX / MCP (optional) ===
# CODEX_GITHUB_PERSONAL_ACCESS_TOKEN=

# === OPTIONAL SIDECAR ===
# OMNIROUTE_TOKEN=
