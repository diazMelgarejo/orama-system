# orama-system local environment overrides
# Copy to .env.local and fill in values — never commit .env.local

# Exa.ai — https://dashboard.exa.ai/keys
EXA_API_KEY=

# OpenRouter — https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Win LM Studio IP (auto-resolved by discovery; override here if needed)
# WIN_LM_STUDIO_IP=

# ── Mac local inference (mutually exclusive runtimes) ─────────────────────────
# Ollama and LM Studio both use localhost but MUST NOT run at the same time on macOS.
# Only one Mac runtime may be active: either Ollama OR LM Studio, never both.
#
# Ollama — required INSTALL at localhost:11434 (need not run 24/7):
#   inference:  qwen3.5:9b-nvfp4
#   embeddings: bge-m3
#   Start on demand, or when mac autoresearch / security-scanner workloads need it.
# OLLAMA_MAC_ENDPOINT=http://localhost:11434
#
# LM Studio — optional alternate Mac runtime (do not run alongside Ollama):
# LM_STUDIO_MAC_ENDPOINT=http://localhost:1234

# ── Fleet mesh endpoints (Win nodes — scripts/mesh/lan_topology_archive.py) ───
# LM_STUDIO_WIN_ENDPOINTS=http://<win-3080-ip>:1234
# LM_STUDIO_WIN_5080_ENDPOINTS=http://<win-5080-ip>:1234

# Gossip + discovery handshake secret — LOCAL ONLY, never commit.
# Generate: python3 scripts/mesh/ensure_local_mesh_secrets.py
# Distribute the same value to every mesh peer (.env.local on each node).
# GOSSIP_SHARED_SECRET=
