// markdownlint-cli2 configuration (matches Perpetua-Tools / diazMelgarejo conventions)
// Run locally: npx markdownlint-cli2 "**/*.md"
{
  "config": {
    "default": true,
    // MD013: Line length -- relaxed to 100 chars (standard across all orama repos)
    "MD013": {
      "line_length": 100,
      "code_blocks": false,
      "tables": false,
      "headings": false
    },
    // MD024: Multiple headings with same content -- allow siblings (common in changelogs/plans)
    "MD024": {
      "siblings_only": true
    },
    // MD029: Ordered list item prefix -- allow ordered prefix (1, 2, 3...)
    "MD029": {
      "style": "ordered"
    },
    // MD033: Inline HTML -- allowed for badges, details/summary, and embedded diagrams
    "MD033": false,
    // MD041: First line should be top-level heading -- relaxed (many skills start with frontmatter)
    "MD041": false
  },
  // ignores: patterns to skip entirely
  //
  // "**/SKILL.md" -- skills are executable agent instructions whose structure
  // is dictated by the skill harness (frontmatter, imperative action blocks,
  // CLI invocations in list items). Applying standard markdown rules to them
  // generates noise without improving agent readability.
  //
  // "**/LESSONS.md" -- the root lessons log was originally exempted.
  // We keep it broad (glob instead of exact path) so that any subsystem
  // or historical lessons files also inherit the exemption automatically.
  // Currently the only LESSONS.md is at docs/LESSONS.md (verified
  // directly, not assumed), but the glob is the more defensive choice
  // as entries keep growing. Matches Perpetua-Tools's own glob pattern.
  //
  // "docs/archive/*-Archived-LESSONS.md" -- added 2026-08-16 when
  // docs/LESSONS.md (4,349 lines) was split into monthly archives
  // (April / May / June+July). The archived entries are moved
  // verbatim (unchanged heading text and body, only reordered
  // oldest-first within each file) from a file this glob already
  // exempted, so the same content-category rationale applies: pasted
  // JSON/long URLs/duplicate section headers repeated per entry
  // (e.g. "### Context", "### Decisions made") are inherent to the
  // log format, not something the split introduced. Verified against
  // markdownlint-cli2 v0.17.2 (CI-pinned): without this entry the 3
  // new archive files surface MD013/MD024/MD031/MD032/MD012/MD042
  // violations that are 100% pre-existing content carried over from
  // docs/LESSONS.md, none newly introduced by the archival split.
  //
  // "docs/superpowers/plans/**" -- same category and same evidence shape as
  // the two globs above, measured the same way rather than assumed. These are
  // generated/appended planning artifacts, not authored prose: the superpowers
  // plan template emits "~~~" fences (which is the entire MD048 count), and
  // /autoplan appends machine-generated review sections, decision audit tables,
  // and voice transcripts to a plan after a human stops editing it.
  //
  // Measured against markdownlint-cli2 v0.17.2 (the CI-pinned version) across
  // every pre-existing plan in this repo, EXCLUDING the two added by the PR
  // that prompted this entry: 585 violations across 15 of 17 files, spread
  // MD013 335 / MD032 109 / MD031 52 / MD022 22 / MD048 18 / MD024 13, plus a
  // long tail. That is a pre-existing, category-wide condition -- these files
  // pass CI today only because the workflow lints CHANGED files, so the debt
  // is invisible until someone touches one. Enforcing the rules now would
  // either fail CI on 15 unrelated historical plans or require a large,
  // separate cleanup pass first -- exactly the tradeoff already documented
  // above for **/SKILL.md.
  //
  // Deliberately NOT exempted: bin/orama-system/skills/**/references/*.md.
  // Those are hand-authored reference docs that a human reads directly, they
  // are cheap to keep compliant, and the PR that added this entry fixed its
  // own new reference doc rather than exempting it.
  "ignores": [
    "**/SKILL.md",
    "**/LESSONS.md",
    "docs/archive/*-Archived-LESSONS.md",
    "docs/superpowers/plans/**"
  ]
}
