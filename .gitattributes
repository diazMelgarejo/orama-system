# Windows batch files must stay CRLF in the working tree — cmd.exe tokenizes on 0d0a (PR #108).
# Git stores normalized text; eol=crlf checks out CRLF. Mac/Linux agents: do not strip \r.
# Policy: bin/orama-system/skills/git-history-surgery/references/platform-line-endings-turf.md
*.cmd  text  eol=crlf
*.bat  text  eol=crlf
*.ps1  text  eol=crlf
