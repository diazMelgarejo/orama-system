{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "SESSION_START_HOOK_PLACEHOLDER",
        "timeout": 120
      }
    ],
    "beforeMCPExecution": [
      {
        "command": "BEFORE_MCP_PR_BODY_GUARD_PLACEHOLDER",
        "timeout": 30
      }
    ],
    "preToolUse": [
      {
        "command": "BEFORE_MCP_PR_BODY_GUARD_PLACEHOLDER",
        "matcher": "ManagePullRequest",
        "timeout": 30
      }
    ],
    "beforeShellExecution": [
      {
        "command": "BEFORE_SHELL_PR_BODY_GUARD_PLACEHOLDER",
        "timeout": 30
      }
    ]
  }
}
