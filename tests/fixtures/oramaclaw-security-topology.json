{
  "_fixture": "security-topology",
  "_note": "Security topology resource — conflict-only policy; timeout must NOT auto-weave.",
  "version": 1,
  "target": {
    "workspace_root": "__TMP__/workspace",
    "config_path": "__TMP__/openclaw.json",
    "state_dir": "__TMP__"
  },
  "resources": [
    {
      "kind": "delegation",
      "id": "main-allows-codex-agent",
      "manager": "codex-binder",
      "policy": "conflict",
      "spec": {
        "path": "agents.defaults.subagents.allowAgents",
        "allow_agent": "codex-agent"
      },
      "managed_paths": ["/agents/defaults/subagents/allowAgents"],
      "security_topology": true
    }
  ]
}
