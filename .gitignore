# LM Studio auto-discovery (generated by discover.py)
.env.lmstudio

# gbrain worktree pin — machine-local, set by /sync-gbrain (kubectl-style context)
# Different machines register under different source names; never commit this.
.gbrain-source

# discover.py runtime marker
config/.policy_cache_refreshed

# lib/ — agentic_stack and other generated/vendored shared libraries
# (content is managed externally; never commit here)
lib/
# Tracked install helpers (OpenClaw .mcp.json bootstrap for CRG)
!bin/orama-system/scripts/lib/
!bin/orama-system/scripts/lib/**

# Vite operator console (web/ subdirectory)
node_modules/
web/node_modules/
.vite/
*.tsbuildinfo
vite.config.d.ts
vite.config.js

# LanceDB runtime artifacts (generated by memory_store tests)
*.lance/
lance_memory.lance/

# Claude Code per-machine settings — contains personal absolute paths in
# permission allowlists. Tracked once accidentally; now gitignored (see
# repo_hygiene PERSONAL_PATH_PATTERN for the lint that catches re-commits).
.claude/settings.local.json

# Cursor private attribution (synced from ~/.cursor/openclaw — never commit)
.cursor/private/
