{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orama.local/schemas/capability-record.schema.json",
  "title": "Orama capability record v1",
  "description": "DRAFT freeze, not ratified. Independent default-deny capability bits. A missing, unreadable or invalid record means every bit is false. A true bit additionally needs a verified operator signature, enforced at startup by the consumer (code capability.unsigned_enablement), not by this schema.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "record_id", "issued_at", "issuer", "capabilities", "binds", "signature"],
  "properties": {
    "schema": { "const": "orama-capability-record/v1" },
    "record_id": { "type": "string", "minLength": 1 },
    "issued_at": {
      "type": "string",
      "description": "RFC 3339 UTC timestamp ending in Z.",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
    },
    "issuer": { "type": "string", "minLength": 1 },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["serving", "effects", "transport", "continuation", "autonomous_settlement"],
      "properties": {
        "serving": { "type": "boolean" },
        "effects": { "type": "boolean" },
        "transport": { "type": "boolean" },
        "continuation": { "type": "boolean" },
        "autonomous_settlement": { "type": "boolean" }
      }
    },
    "binds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["binary_digest", "config_digest"],
      "properties": {
        "binary_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "config_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      }
    },
    "signature": {
      "type": ["string", "null"],
      "minLength": 1,
      "pattern": "\\S",
      "description": "null while every bit is false. A non-blank string is an operator signature envelope whose verification is outside this schema."
    }
  },
  "if": {
    "properties": {
      "capabilities": {
        "anyOf": [
          { "properties": { "serving": { "const": true } }, "required": ["serving"] },
          { "properties": { "effects": { "const": true } }, "required": ["effects"] },
          { "properties": { "transport": { "const": true } }, "required": ["transport"] },
          { "properties": { "continuation": { "const": true } }, "required": ["continuation"] },
          { "properties": { "autonomous_settlement": { "const": true } }, "required": ["autonomous_settlement"] }
        ]
      }
    },
    "required": ["capabilities"]
  },
  "then": {
    "properties": { "signature": { "type": "string" } }
  }
}
