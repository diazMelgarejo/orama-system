{
  "mcpServers": {
    "exa": {
      "command": "bash",
      "args": ["-c", "if [ -f \"$PWD/scripts/exa/exa-mcp-wrapper.sh\" ]; then exec \"$PWD/scripts/exa/exa-mcp-wrapper.sh\"; fi; W=\"$(bash \"$PWD/scripts/exa/resolve-orama-root.sh\" 2>/dev/null)\"; exec \"$W/scripts/exa/exa-mcp-wrapper.sh\""]
    },
    "code-review-graph": {
      "command": "uvx",
      "args": [
        "code-review-graph",
        "serve"
      ],
      "env": {
        "PYTHON": "python3",
        "CRG_OPENAI_API_KEY": "ollama",
        "CRG_OPENAI_BASE_URL": "http://localhost:11434/v1",
        "CRG_OPENAI_MODEL": "bge-m3",
        "CRG_OPENAI_DIMENSION": "1024",
        "CRG_ACCEPT_CLOUD_EGRESS": "1"
      }
    },
    "oramasys": {
      "command": "python",
      "args": [
        "bin/mcp_servers/openclaw_mcp_server.py"
      ],
      "id": "mcp/oramasys"
    },
    "chrome-devtools": {
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@latest"
      ]
    }
  }
}
