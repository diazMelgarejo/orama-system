{
  "install": "bash -c 'set -e; (command -v apt-get >/dev/null && sudo DEBIAN_FRONTEND=noninteractive apt-get install -y -qq python3-venv python3.12-venv 2>/dev/null || true); python3 -m venv .venv && source .venv/bin/activate && OPENCLAW_HOME=\"${OPENCLAW_HOME:-$HOME/openclaw-v1}\" && mkdir -p \"$OPENCLAW_HOME\" && [ -d \"$OPENCLAW_HOME/Perpetua-Tools\" ] || git clone --branch main https://github.com/diazMelgarejo/Perpetua-Tools \"$OPENCLAW_HOME/Perpetua-Tools\" && [ -d \"$OPENCLAW_HOME/AlphaClaw\" ] || git clone --branch main https://github.com/diazMelgarejo/AlphaClaw \"$OPENCLAW_HOME/AlphaClaw\" && pip install -q -e \".[test]\" && pip install -q -e \"$OPENCLAW_HOME/Perpetua-Tools\" && pip install -q pytest pytest-asyncio pyyaml && (cd \"$OPENCLAW_HOME/AlphaClaw\" && npm install) && (npm list -g openclaw >/dev/null 2>&1 || npm install -g openclaw@2026.5.6) && bash scripts/git/apply-attribution-guard-all-repos.sh'",

  "environment": {
    "OPENCLAW_HOME": "$HOME/openclaw-v1",
    "ORAMA_SYSTEM_PATH": "${workspaceFolder}",
    "PERPETUA_TOOLS_PATH": "$HOME/openclaw-v1/Perpetua-Tools",
    "ALPHACLAW_INSTALL_DIR": "$HOME/openclaw-v1/AlphaClaw",
    "OPENCLAW_GATEWAY_URL": "http://localhost:18789",
    "LM_STUDIO_URL": "http://localhost:1234",
    "OLLAMA_MAC_ENDPOINT": "http://localhost:11434",
    "LM_STUDIO_MAC_ENDPOINT": "http://localhost:1234",
    "ORCHESTRATOR_ENDPOINT": "http://localhost:8000",
    "ULTRATHINK_ENDPOINT": "http://localhost:8001",
    "OPENAI_API_KEY": "sk-local",
    "PYTHONPATH": "${workspaceFolder}:${workspaceFolder}/scripts:$HOME/openclaw-v1/Perpetua-Tools",
    "REPO_ROOT": "${workspaceFolder}",
    "ULTRATHINK_PORT": "8001",
    "PORTAL_PORT": "8002",
    "ALPHACLAW_PORT": "3000"
  },

  "terminals": [
    {
      "name": "orama tests",
      "command": "source .venv/bin/activate && python -m pytest tests/ -v"
    },
    {
      "name": "PT tests",
      "command": "source .venv/bin/activate && cd $OPENCLAW_HOME/Perpetua-Tools && python -m pytest tests/ -v"
    },
    {
      "name": "AlphaClaw tests",
      "command": "cd $OPENCLAW_HOME/AlphaClaw && npm test"
    },
    {
      "name": "PT portal",
      "command": "source .venv/bin/activate && cd $OPENCLAW_HOME/Perpetua-Tools && uvicorn orchestrator.api:app --reload --port 8000"
    },
    {
      "name": "openclaw gateway",
      "command": "openclaw gateway start --port 18789"
    },
    {
      "name": "discover network",
      "command": "source .venv/bin/activate && python scripts/discover.py --force"
    },
    {
      "name": "hygiene gate (orama)",
      "command": "source .venv/bin/activate && python scripts/review/repo_hygiene.py ."
    },
    {
      "name": "hygiene gate (PT)",
      "command": "source .venv/bin/activate && python $OPENCLAW_HOME/Perpetua-Tools/scripts/review/repo_hygiene.py $OPENCLAW_HOME/Perpetua-Tools"
    },
    {
      "name": "orama API server (8001)",
      "command": "source .venv/bin/activate && uvicorn api_server:app --reload --port 8001"
    },
    {
      "name": "orama portal (8002)",
      "command": "source .venv/bin/activate && python portal_server.py"
    },
    {
      "name": "AlphaClaw server (3000)",
      "command": "cd $OPENCLAW_HOME/AlphaClaw && node bin/alphaclaw.js start"
    }
  ]
}
